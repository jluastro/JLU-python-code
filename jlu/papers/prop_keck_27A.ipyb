    "for targ in ['MB09260','OB110462']:\n",
    "    if targ == 'OB110462':\n",
    "        fit_targ, dat_targ = multinest_utils.get_data_and_fitter(ast_fits['OB110462'])\n",
    "    else:\n",
    "        fit_targ, dat_targ = multinest_utils.get_data_and_fitter(phot_ast_fits[targ])\n",
    "\n",
    "    res_targ = fit_targ.load_mnest_results()\n",
    "    res_targ['muRel'] = np.hypot(res_targ['muRel_E'], res_targ['muRel_N'])\n",
    "\n",
    "    print(targ, 'muRel', get_med_1sig(res_targ, 'muRel'))\n",
    "    print(targ, 'muRel', get_med_1sig(res_targ, 'tE'))"
   ]
